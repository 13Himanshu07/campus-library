<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>timestamp=%date{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level thread=%thread request_id=%X{requestId:-none} logger=%logger{36} %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
