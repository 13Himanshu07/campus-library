<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Campus Library</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body class="auth-page"><a class="brand auth-brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">L</span> Campus Library</a><main class="auth-card"><div class="eyebrow">WELCOME BACK</div><h1>Sign in</h1><p class="muted">Use your campus library account.</p><c:if test="${not empty errorMessage}"><div class="alert error"><c:out value="${errorMessage}"/></div></c:if><c:if test="${not empty sessionScope.flashMessage}"><div class="alert success"><c:out value="${sessionScope.flashMessage}"/></div><c:remove var="flashMessage" scope="session"/></c:if><form method="post" action="${pageContext.request.contextPath}/login" class="stack"><label>Email address<input type="email" name="email" required autocomplete="username" value="<c:out value='${param.email}'/>"/></label><label>Password<input type="password" name="password" required autocomplete="current-password"/></label><button class="button primary full">Sign in <span>→</span></button></form><div class="auth-bottom">New to the library? <a href="${pageContext.request.contextPath}/register">Create an account</a></div></main></body></html>
