<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Join · Campus Library</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body class="auth-page"><a class="brand auth-brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">L</span> Campus Library</a><main class="auth-card"><div class="eyebrow">YOUR READING DESK</div><h1>Create account</h1><p class="muted">Register as a student member.</p><c:if test="${not empty errorMessage}"><div class="alert error"><c:out value="${errorMessage}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register" class="stack"><label>Full name<input name="name" required maxlength="120"/></label><label>Campus email<input type="email" name="email" required maxlength="190"/></label><label>Membership ID <span class="optional">(optional)</span><input name="membershipId" maxlength="40" placeholder="Generated if left blank"/></label><label>Phone <span class="optional">(optional)</span><input name="phone" maxlength="40"/></label><label>Password<input type="password" name="password" required minlength="10" autocomplete="new-password"/><small>Use at least 10 characters.</small></label><label class="check-label"><input type="checkbox" name="librarianApplication"/> Apply for librarian access (requires approval)</label><button class="button primary full">Create account <span>→</span></button></form><div class="auth-bottom">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></div></main></body></html>
