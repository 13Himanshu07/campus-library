<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="topbar">
  <button class="mobile-menu icon-btn" type="button" aria-label="Open navigation" data-sidebar-open>&#9776;</button>
  <div class="crumb"><span class="crumb-mark" aria-hidden="true">&#9636;</span><span>Library workspace</span><span class="crumb-dot">/</span><b><c:choose><c:when test="${sessionScope.role == 'ADMIN'}">Administrator</c:when><c:when test="${sessionScope.role == 'LIBRARIAN'}">Librarian</c:when><c:otherwise>Member</c:otherwise></c:choose> portal</b></div>
  <div class="topbar-user"><span class="online-dot"></span><span>Service online</span></div>
</header>
