<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/app/dashboard"><span class="brand-mark">L</span><span>Campus Library<small>COLLECTION & CIRCULATION</small></span></a><div class="side-label">YOUR LIBRARY</div><nav class="side-nav"><a href="${pageContext.request.contextPath}/app/dashboard">▦ <span>Overview</span></a><a href="${pageContext.request.contextPath}/app/books">▤ <span>Browse books</span></a><c:if test="${sessionScope.role == 'STUDENT'}"><a href="${pageContext.request.contextPath}/app/my-books">▣ <span>My books</span></a><a href="${pageContext.request.contextPath}/app/history">◷ <span>History</span></a><a href="${pageContext.request.contextPath}/app/fines">₹ <span>My fines</span></a><a href="${pageContext.request.contextPath}/app/profile">◎ <span>Profile</span></a></c:if><c:if test="${sessionScope.role == 'LIBRARIAN' || sessionScope.role == 'ADMIN'}"><div class="side-label side-label-gap">LIBRARY DESK</div><a href="${pageContext.request.contextPath}/librarian/issues">⇄ <span>Transactions</span></a><a href="${pageContext.request.contextPath}/librarian/users">♙ <span>Members</span></a><a href="${pageContext.request.contextPath}/librarian/fines">₹ <span>Fines</span></a><a href="${pageContext.request.contextPath}/librarian/categories">◇ <span>Categories</span></a><a href="${pageContext.request.contextPath}/librarian/books/add">＋ <span>Add a book</span></a></c:if><c:if test="${sessionScope.role == 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin/dashboard">⚙ <span>Administration</span></a><a href="${pageContext.request.contextPath}/admin/applications">✓ <span>Applications</span></a></c:if></nav><div class="side-bottom"><span class="avatar"><c:out value="${sessionScope.userName.substring(0,1)}"/></span><div class="account-name"><b><c:out value="${sessionScope.userName}"/></b><small><c:out value="${sessionScope.role}"/></small></div><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><button class="logout" title="Sign out">↗</button></form></div></aside>
