<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Profile & settings"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">YOUR ACCOUNT</div><h2>Profile & settings</h2><p>Keep your member details current.</p></div></div><section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/app/profile" class="stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Full name<input name="name" value="<c:out value='${profile.name}'/>" required maxlength="120"/></label><label>Email address<input type="email" name="email" value="<c:out value='${profile.email}'/>" required maxlength="190"/></label><label>Phone<input name="phone" value="<c:out value='${profile.phone}'/>" maxlength="40"/></label><div class="readonly">Membership ID <b><c:out value="${profile.membershipId}"/></b></div><button class="button primary">Save changes</button></form></section><section class="panel form-panel"><div class="eyebrow">ACCOUNT SECURITY</div><h2 class="form-heading">Change password</h2><form method="post" action="${pageContext.request.contextPath}/app/password" class="stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password"/></label><label>New password<input type="password" name="newPassword" required minlength="10" autocomplete="new-password"/></label><label>Confirm new password<input type="password" name="confirmPassword" required minlength="10" autocomplete="new-password"/></label><button class="button outline">Update password</button></form></section><%@ include file="../shared/close.jspf" %>
