<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Profile &amp; settings"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">YOUR ACCOUNT</div><h1>Profile &amp; settings</h1><p>Keep your member details current.</p></div></div>
<div class="settings-grid">
  <section class="panel settings-panel"><div class="panel-heading"><div><h2>Personal details</h2><p>Your account information</p></div></div><form method="post" action="${pageContext.request.contextPath}/app/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Full name<input name="name" value="<c:out value='${profile.name}'/>" required maxlength="120"/></label><label>Email address<input type="email" name="email" value="<c:out value='${profile.email}'/>" required maxlength="190"/></label><label>Phone number<input name="phone" value="<c:out value='${profile.phone}'/>" maxlength="40"/></label><div class="read-only">Membership ID <b><c:out value="${profile.membershipId}"/></b></div><button class="btn btn-dark">Save profile <span>→</span></button></form></section>
  <div class="settings-stack"><section class="panel settings-panel"><div class="panel-heading"><div><h2>Change password</h2><p>Choose a strong password you haven’t used before.</p></div></div><form method="post" action="${pageContext.request.contextPath}/app/password" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password"/></label><label>New password<input type="password" name="newPassword" required minlength="10" autocomplete="new-password"/></label><label>Confirm new password<input type="password" name="confirmPassword" required minlength="10" autocomplete="new-password"/></label><button class="btn btn-outline">Update password</button></form></section></div>
</div>
<%@ include file="../shared/close.jspf" %>
