<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Your reading desk"/><%@ include file="../shared/open.jspf" %>
<div class="welcome"><div><div class="eyebrow">MEMBER OVERVIEW</div><h2>Good to see you, <c:out value="${sessionScope.userName}"/>.</h2><p>Pick up where you left off or find something new to read.</p></div><a class="button primary" href="${pageContext.request.contextPath}/app/books">Explore collection →</a></div>
<div class="stat-grid"><article class="stat-card"><span>Titles in collection</span><strong>${stats.titles}</strong><small>Across all subjects</small></article><article class="stat-card"><span>Copies available</span><strong>${stats.available}</strong><small>Ready to borrow</small></article><article class="stat-card"><span>Your active loans</span><strong>${activeIssues.size()}</strong><small>Borrowing limit: 5</small></article><article class="stat-card"><span>Unpaid fines</span><strong>₹${stats.unpaidFinesCents / 100}</strong><small>Calculated at return</small></article></div>
<section class="panel"><div class="section-heading"><div><div class="eyebrow">DUE DATES</div><h2>Currently borrowed</h2></div><a class="text-link" href="${pageContext.request.contextPath}/app/my-books">View all →</a></div><c:choose><c:when test="${not empty activeIssues}"><div class="table-wrap"><table><thead><tr><th>BOOK</th><th>ISSUED</th><th>DUE DATE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${activeIssues}" var="loan"><tr><td><b><c:out value="${loan.bookTitle}"/></b><small><c:out value="${loan.author}"/></small></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td><span class="badge ${loan.status}">${loan.status}</span></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="empty">No books on loan. The next good read is waiting in the <a href="${pageContext.request.contextPath}/app/books">collection</a>.</div></c:otherwise></c:choose></section>
<%@ include file="../shared/close.jspf" %>
