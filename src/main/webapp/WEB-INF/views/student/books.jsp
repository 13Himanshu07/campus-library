<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Browse the collection"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">THE COLLECTION</div><h2>Find your next read.</h2><p>Search titles, authors, ISBNs, and subjects.</p></div><c:if test="${sessionScope.role == 'LIBRARIAN' || sessionScope.role == 'ADMIN'}"><a class="button primary" href="${pageContext.request.contextPath}/librarian/books/add">＋ Add book</a></c:if></div>
<form class="search-form" method="get" action="${pageContext.request.contextPath}/app/search"><span>⌕</span><input name="q" value="<c:out value='${query}'/>" placeholder="Search the catalog…"/><button class="button dark">Search</button></form>
<c:if test="${not empty books}"><div class="book-grid"><c:forEach items="${books}" var="book"><article class="book-card"><div class="book-cover"><span><c:out value="${book.categoryName}"/></span><strong><c:out value="${book.title}"/></strong><small><c:out value="${book.author}"/></small></div><div class="book-info"><div class="book-meta"><span><c:out value="${book.isbn}"/></span><span class="badge ${book.availableCopies > 0 ? 'available' : 'unavailable'}">${book.availableCopies} available</span></div><c:if test="${not empty book.description}"><p><c:out value="${book.description}"/></p></c:if><c:choose><c:when test="${sessionScope.role == 'STUDENT'}"><form method="post" action="${pageContext.request.contextPath}/app/issues/borrow"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="bookId" value="${book.id}"/><button class="button outline" ${book.availableCopies == 0 ? 'disabled' : ''}>Request this book →</button></form></c:when><c:otherwise><div class="book-actions"><a class="text-link" href="${pageContext.request.contextPath}/librarian/books/edit?id=${book.id}">Edit</a><form method="post" action="${pageContext.request.contextPath}/librarian/books/delete" onsubmit="return confirm('Remove this title from the catalog?')"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${book.id}"/><button class="text-link danger">Remove</button></form></div></c:otherwise></c:choose></div></article></c:forEach></div></c:if><c:if test="${empty books}"><div class="empty">No matching titles. Try a different search term.</div></c:if>
<%@ include file="../shared/close.jspf" %>
