<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Browse the collection"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">THE COLLECTION</div><h1>Find your next read.</h1><p>Search by title, author, ISBN, or subject and follow your curiosity.</p></div><c:if test="${sessionScope.role == 'LIBRARIAN' || sessionScope.role == 'ADMIN'}"><a class="btn btn-dark" href="${pageContext.request.contextPath}/librarian/books/add">＋ Add book</a></c:if></div>
<form class="catalog-toolbar" method="get" action="${pageContext.request.contextPath}/app/search"><label class="searchbox"><span aria-hidden="true">⌕</span><input name="q" value="<c:out value='${query}'/>" placeholder="Search titles, authors, ISBN, subject…"/></label><button class="btn btn-dark" type="submit">Search <span>→</span></button><span class="result-count"><c:out value="${books.size()}"/> titles on this page</span></form>
<c:choose><c:when test="${not empty books}"><div class="books-grid"><c:forEach items="${books}" var="book" varStatus="loop"><article class="book-card"><div class="book-art cover-${loop.index % 6}"><span class="cover-mark"><c:out value="${empty book.categoryName ? 'L' : book.categoryName.substring(0,1)}"/></span><div class="cover-title"><c:out value="${book.title}"/></div><div class="cover-author"><c:out value="${book.author}"/></div></div><div class="book-card-info"><div class="book-meta"><span><c:out value="${book.categoryName}"/></span><span class="${book.availableCopies > 0 ? 'available-label' : 'unavailable-label'}"><c:out value="${book.availableCopies}"/> available</span></div><h3><c:out value="${book.title}"/></h3><p>by <c:out value="${book.author}"/></p><c:if test="${not empty book.description}"><p class="book-description"><c:out value="${book.description}"/></p></c:if><div class="book-card-bottom"><c:choose><c:when test="${sessionScope.role == 'STUDENT'}"><form method="post" action="${pageContext.request.contextPath}/app/issues/borrow"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="bookId" value="${book.id}"/><button class="btn btn-outline btn-sm" ${book.availableCopies == 0 ? 'disabled' : ''}>Request this book <span>→</span></button></form></c:when><c:otherwise><a class="text-link" href="${pageContext.request.contextPath}/librarian/books/edit?id=${book.id}">Edit details</a><form method="post" action="${pageContext.request.contextPath}/librarian/books/delete" onsubmit="return confirm('Remove this title from the catalog?')"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${book.id}"/><button class="text-link danger-text">Remove</button></form></c:otherwise></c:choose><small>ISBN <c:out value="${book.isbn}"/></small></div></div></article></c:forEach></div></c:when><c:otherwise><div class="panel empty-catalog"><span class="empty-icon">▤</span><b>No titles found</b><span>Try a different search term.</span></div></c:otherwise></c:choose>
<%@ include file="../shared/close.jspf" %>
