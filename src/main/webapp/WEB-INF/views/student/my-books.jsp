<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Books with you"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">YOUR LOANS</div><h2>Books with you</h2><p>Returns are verified by a librarian at the circulation desk.</p></div><a class="button outline" href="${pageContext.request.contextPath}/app/books">Browse books</a></div>
<section class="panel"><c:choose><c:when test="${not empty issues}"><div class="table-wrap"><table><thead><tr><th>BOOK</th><th>ISSUED</th><th>DUE DATE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${issues}" var="loan"><tr><td><b><c:out value="${loan.bookTitle}"/></b><small><c:out value="${loan.author}"/></small></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td><span class="badge ${loan.status}">${loan.status}</span></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="empty">You have no books on loan right now.</div></c:otherwise></c:choose></section><%@ include file="../shared/close.jspf" %>
