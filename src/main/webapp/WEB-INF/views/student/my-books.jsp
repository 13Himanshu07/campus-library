<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Books with you"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">YOUR READING DESK</div><h1>Books with you</h1><p>Keep an eye on due dates. A librarian will verify the book at the desk before marking it returned.</p></div><a class="btn btn-outline" href="${pageContext.request.contextPath}/app/books">Browse books <span>→</span></a></div>
<section class="panel table-panel"><div class="panel-heading"><div><h2>Currently borrowed</h2><p><c:out value="${issues.size()}"/> active books</p></div></div>
  <c:choose><c:when test="${not empty issues}"><div class="table-scroll"><table><thead><tr><th>BOOK</th><th>DATE BORROWED</th><th>DUE DATE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${issues}" var="loan"><tr><td><b><c:out value="${loan.bookTitle}"/></b><small class="table-sub"><c:out value="${loan.author}"/></small></td><td><c:out value="${loan.issueDate}"/></td><td><c:out value="${loan.dueDate}"/></td><td><span class="status ${loan.status == 'OVERDUE' ? 'overdue' : loan.status == 'RETURNED' ? 'returned' : 'issued'}"><c:out value="${loan.status}"/></span></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="empty-state"><span class="empty-icon">▣</span><b>No borrowed books at the moment</b><span>Explore the collection to find your next read.</span><a href="${pageContext.request.contextPath}/app/books" class="btn btn-outline">Browse books</a></div></c:otherwise></c:choose>
</section>
<%@ include file="../shared/close.jspf" %>
