<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Borrowing history"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">YOUR READING JOURNEY</div><h1>Borrowing history</h1><p>A shelf of the books you’ve taken along the way.</p></div></div>
<div class="catalog-toolbar"><div class="result-count"><c:out value="${issues.size()}"/> borrowing records</div></div>
<section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>BOOK</th><th>DATE BORROWED</th><th>DUE DATE</th><th>RETURNED</th><th>FINE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${issues}" var="loan"><tr><td><b><c:out value="${loan.bookTitle}"/></b><small class="table-sub"><c:out value="${loan.author}"/></small></td><td><c:out value="${loan.issueDate}"/></td><td><c:out value="${loan.dueDate}"/></td><td><c:out value="${empty loan.returnDate ? '—' : loan.returnDate}"/></td><td>₹<c:out value="${loan.fineAmount}"/></td><td><span class="status ${loan.status == 'OVERDUE' ? 'overdue' : loan.status == 'RETURNED' ? 'returned' : 'issued'}"><c:out value="${loan.status}"/></span></td></tr></c:forEach></tbody></table></div>
  <c:if test="${empty issues}"><div class="empty-inline">No history to show yet.</div></c:if>
</section>
<%@ include file="../shared/close.jspf" %>
