<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Borrowing history"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">YOUR READING JOURNEY</div><h2>Borrowing history</h2><p>Every book you have checked out from the library.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>BOOK</th><th>ISSUED</th><th>DUE</th><th>RETURNED</th><th>FINE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${issues}" var="loan"><tr><td><b><c:out value="${loan.bookTitle}"/></b><small><c:out value="${loan.author}"/></small></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td>${empty loan.returnDate ? '—' : loan.returnDate}</td><td>₹${loan.fineAmount}</td><td><span class="badge ${loan.status}">${loan.status}</span></td></tr></c:forEach></tbody></table></div><c:if test="${empty issues}"><div class="empty">Your completed and current loans will show up here.</div></c:if></section><%@ include file="../shared/close.jspf" %>
