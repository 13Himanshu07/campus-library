<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Administrator overview"/><%@ include file="../shared/open.jspf" %>
<div class="welcome"><div><div class="eyebrow">ADMINISTRATION</div><h2>Library at a glance</h2><p>Review pending access and monitor the live catalog.</p></div><a class="button primary" href="${pageContext.request.contextPath}/admin/applications">Review applications · ${stats.pendingLibrarians}</a></div><div class="stat-grid"><article class="stat-card"><span>Catalog titles</span><strong>${stats.titles}</strong><small>${stats.copies} total copies</small></article><article class="stat-card"><span>Available copies</span><strong>${stats.available}</strong><small>Current stock</small></article><article class="stat-card"><span>Active loans</span><strong>${stats.openIssues}</strong><small>${stats.overdue} overdue</small></article><article class="stat-card"><span>Applications</span><strong>${stats.pendingLibrarians}</strong><small>Awaiting a decision</small></article></div><section class="panel"><div class="section-heading"><div><div class="eyebrow">RECENT ACTIVITY</div><h2>Latest loans</h2></div></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>BOOK</th><th>ISSUED</th><th>DUE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${recentIssues}" var="loan"><tr><td><c:out value="${loan.memberName}"/></td><td><c:out value="${loan.bookTitle}"/></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td><span class="badge ${loan.status}">${loan.status}</span></td></tr></c:forEach></tbody></table></div></section><%@ include file="../shared/close.jspf" %>
