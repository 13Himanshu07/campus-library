<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Librarian applications"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">ACCOUNT REVIEW</div><h2>Librarian applications</h2><p>Approve access to inventory and circulation tools.</p></div><span class="count-pill">${applications.size()} pending</span></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>APPLICANT</th><th>MEMBERSHIP ID</th><th>SUBMITTED ROLE</th><th>DECISION</th></tr></thead><tbody><c:forEach items="${applications}" var="applicant"><tr><td><b><c:out value="${applicant.name}"/></b><small><c:out value="${applicant.email}"/></small></td><td><c:out value="${applicant.membershipId}"/></td><td><span class="badge">PENDING</span></td><td><div class="book-actions"><c:forTokens items="approve,reject" delims="," var="decision"><form method="post" action="${pageContext.request.contextPath}/admin/applications"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${applicant.id}"/><input type="hidden" name="decision" value="${decision}"/><button class="text-link ${decision == 'reject' ? 'danger' : ''}">${decision == 'approve' ? 'Approve' : 'Decline'}</button></form></c:forTokens></div></td></tr></c:forEach></tbody></table></div><c:if test="${empty applications}"><div class="empty">There are no pending applications.</div></c:if></section><%@ include file="../shared/close.jspf" %>
