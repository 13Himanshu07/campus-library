<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Librarian applications"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">ACCOUNT REVIEW</div><h1>Librarian applications</h1><p>Approve access to inventory and circulation tools.</p></div><span class="panel-tag"><c:out value="${applications.size()}"/> PENDING</span></div>
<section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>APPLICANT</th><th>MEMBERSHIP ID</th><th>SUBMITTED ROLE</th><th>DECISION</th></tr></thead><tbody><c:forEach items="${applications}" var="applicant"><tr><td><div class="table-person"><span class="avatar tiny">♙</span><div><b><c:out value="${applicant.name}"/></b><small class="table-sub"><c:out value="${applicant.email}"/></small></div></div></td><td><c:out value="${applicant.membershipId}"/></td><td><span class="status pending">PENDING</span></td><td><div class="decision-actions"><c:forTokens items="approve,reject" delims="," var="decision"><form method="post" action="${pageContext.request.contextPath}/admin/applications"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${applicant.id}"/><input type="hidden" name="decision" value="${decision}"/><button class="text-link ${decision == 'reject' ? 'danger-text' : ''}"><c:out value="${decision == 'approve' ? 'Approve' : 'Decline'}"/></button></form></c:forTokens></div></td></tr></c:forEach></tbody></table></div>
  <c:if test="${empty applications}"><div class="empty-inline">There are no pending applications.</div></c:if>
</section>
<%@ include file="../shared/close.jspf" %>
