<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Library overview"/><%@ include file="../shared/open.jspf" %>
<div class="welcome"><div><div class="eyebrow">CIRCULATION DESK</div><h2>Library at a glance</h2><p>Inventory and circulation statistics from the live database.</p></div><a class="button primary" href="${pageContext.request.contextPath}/librarian/books/add">＋ Add a book</a></div>
<div class="stat-grid"><article class="stat-card"><span>Titles</span><strong>${stats.titles}</strong><small>Active catalog records</small></article><article class="stat-card"><span>Total copies</span><strong>${stats.copies}</strong><small>${stats.available} available now</small></article><article class="stat-card"><span>Books on loan</span><strong>${stats.openIssues}</strong><small>${stats.overdue} overdue</small></article><article class="stat-card"><span>Active students</span><strong>${stats.students}</strong><small>₹${stats.unpaidFinesCents / 100} in unpaid fines</small></article></div>
<section class="panel"><div class="section-heading"><div><div class="eyebrow">RECENT ACTIVITY</div><h2>Latest loans</h2></div><a class="text-link" href="${pageContext.request.contextPath}/librarian/issues">Manage transactions →</a></div><div class="table-wrap"><table><thead><tr><th>MEMBER</th><th>BOOK</th><th>ISSUED</th><th>DUE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${recentIssues}" var="loan"><tr><td><b><c:out value="${loan.memberName}"/></b><small><c:out value="${loan.memberEmail}"/></small></td><td><c:out value="${loan.bookTitle}"/></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td><span class="badge ${loan.status}">${loan.status}</span></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="../shared/close.jspf" %>
