<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="editing" value="${book.id > 0}"/><c:set var="pageTitle" value="${editing ? 'Edit book' : 'Add a book'}"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">COLLECTION RECORD</div><h1><c:out value="${editing ? 'Edit book details' : 'Add a book'}"/></h1><p>Catalog information and copy count.</p></div><a class="btn btn-quiet" href="${pageContext.request.contextPath}/app/books">← Back to collection</a></div>
<section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/librarian/books/${editing ? 'edit' : 'add'}" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><c:if test="${editing}"><input type="hidden" name="id" value="${book.id}"/></c:if><div class="form-row"><label>Book title<input name="title" required maxlength="255" value="<c:out value='${book.title}'/>"/></label><label>Author<input name="author" required maxlength="180" value="<c:out value='${book.author}'/>"/></label><label>ISBN<input name="isbn" required maxlength="32" value="<c:out value='${book.isbn}'/>"/></label><label>Category<select name="categoryId"><option value="0">Uncategorized</option><c:forEach items="${categories}" var="category"><option value="${category.id}" ${book.categoryId == category.id ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select></label><label>Publisher<input name="publisher" maxlength="180" value="<c:out value='${book.publisher}'/>"/></label><label>Publication year<input type="number" name="publicationYear" min="0" max="2100" value="<c:out value='${book.publicationYear}'/>"/></label><label>Total copies<input type="number" name="totalCopies" min="0" required value="${editing ? book.totalCopies : 1}"/></label></div><label>Description<textarea name="description" rows="4" maxlength="3000"><c:out value="${book.description}"/></textarea></label><button class="btn btn-dark"><c:out value="${editing ? 'Save changes' : 'Add to collection'}"/> <span>→</span></button></form></section>
<%@ include file="../shared/close.jspf" %>
