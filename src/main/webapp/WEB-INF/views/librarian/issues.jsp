<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Transactions"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">CIRCULATION DESK</div><h2>Loans & returns</h2><p>Verify the physical return before closing a loan.</p></div><span class="count-pill">${overdue.size()} overdue</span></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>BOOK</th><th>ISSUED</th><th>DUE</th><th>STATUS</th><th></th></tr></thead><tbody><c:forEach items="${issues}" var="loan"><tr><td><b><c:out value="${loan.memberName}"/></b><small><c:out value="${loan.memberEmail}"/></small></td><td><c:out value="${loan.bookTitle}"/></td><td>${loan.issueDate}</td><td>${loan.dueDate}</td><td><span class="badge ${loan.status}">${loan.status}</span></td><td><c:if test="${loan.status != 'RETURNED'}"><form method="post" action="${pageContext.request.contextPath}/librarian/issues/return" onsubmit="return confirm('Confirm that this book has physically been returned?')"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="issueId" value="${loan.id}"/><button class="button small outline">Record return</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty issues}"><div class="empty">No circulation records yet.</div></c:if></section><%@ include file="../shared/close.jspf" %>
