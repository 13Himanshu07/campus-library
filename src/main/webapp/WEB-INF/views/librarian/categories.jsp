<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Categories"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">CATALOG ORGANIZATION</div><h1>Book categories</h1><p>Group titles into useful subjects.</p></div></div>
<div class="settings-grid">
  <section class="panel settings-panel"><div class="panel-heading"><div><h2>Add a category</h2><p>Create a subject for the collection.</p></div></div><form method="post" action="${pageContext.request.contextPath}/librarian/categories" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Category name<input name="name" required maxlength="100"/></label><label>Description<textarea name="description" rows="3" maxlength="500"></textarea></label><button class="btn btn-dark">Add category <span>→</span></button></form></section>
  <section class="panel settings-panel"><div class="panel-heading"><div><h2>Current categories</h2><p><c:out value="${categories.size()}"/> subjects in the catalog</p></div></div><div class="rank-list category-ranks"><c:forEach items="${categories}" var="category"><div><span class="rank-number">◇</span><div class="category-copy"><b><c:out value="${category.name}"/></b><small><c:out value="${category.description}"/></small></div></div></c:forEach><c:if test="${empty categories}"><div class="empty-inline">No categories have been added yet.</div></c:if></div></section>
</div>
<%@ include file="../shared/close.jspf" %>
