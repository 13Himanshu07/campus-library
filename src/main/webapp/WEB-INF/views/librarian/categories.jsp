<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Categories"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">CATALOG ORGANIZATION</div><h2>Book categories</h2><p>Group titles into useful subjects.</p></div></div><section class="panel split-panel"><form method="post" action="${pageContext.request.contextPath}/librarian/categories" class="stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><label>Category name<input name="name" required maxlength="100"/></label><label>Description<textarea name="description" rows="3" maxlength="500"></textarea></label><button class="button primary">Add category</button></form><div class="category-list"><c:forEach items="${categories}" var="category"><article><span>◇</span><div><b><c:out value="${category.name}"/></b><small><c:out value="${category.description}"/></small></div></article></c:forEach></div></section><%@ include file="../shared/close.jspf" %>
