<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Members"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">COMMUNITY DIRECTORY</div><h2>Student members</h2><p>Review account status and membership details.</p></div><span class="count-pill">${users.size()} members</span></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>MEMBER</th><th>MEMBERSHIP ID</th><th>STATUS</th><th>ACCOUNT</th></tr></thead><tbody><c:forEach items="${users}" var="member"><tr><td><b><c:out value="${member.name}"/></b><small><c:out value="${member.email}"/></small></td><td><c:out value="${member.membershipId}"/></td><td><span class="badge ${member.status}">${member.status}</span></td><td><c:if test="${member.status == 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/librarian/users" onsubmit="return confirm('Disable this student account?')"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${member.id}"/><button class="text-link danger">Disable</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty users}"><div class="empty">There are no student accounts to show.</div></c:if></section><%@ include file="../shared/close.jspf" %>
