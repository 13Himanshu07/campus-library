<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Members"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow">COMMUNITY DIRECTORY</div><h1>Student members</h1><p>Review account status and membership details.</p></div><span class="panel-tag"><c:out value="${users.size()}"/> MEMBERS</span></div>
<section class="panel table-panel"><div class="panel-heading"><div><h2>Member accounts</h2><p>Library community directory</p></div></div><div class="table-scroll"><table><thead><tr><th>MEMBER</th><th>MEMBERSHIP ID</th><th>STATUS</th><th>ACCOUNT</th></tr></thead><tbody><c:forEach items="${users}" var="member"><tr><td><div class="table-person"><span class="avatar tiny">♙</span><div><b><c:out value="${member.name}"/></b><small class="table-sub"><c:out value="${member.email}"/></small></div></div></td><td><c:out value="${member.membershipId}"/></td><td><span class="status ${member.status == 'ACTIVE' ? 'active' : 'disabled'}"><c:out value="${member.status}"/></span></td><td><c:if test="${member.status == 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/librarian/users" data-confirm="Disable this student account?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="id" value="${member.id}"/><button class="text-link danger-text">Disable</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty users}"><div class="empty-inline">There are no student accounts to show.</div></c:if></section>
<%@ include file="../shared/close.jspf" %>
