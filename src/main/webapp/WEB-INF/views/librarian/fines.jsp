<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Fines"/><%@ include file="../shared/open.jspf" %>
<div class="welcome compact"><div><div class="eyebrow">LATE RETURNS</div><h2>Fine records</h2><p>Fines are calculated when an overdue book is returned at ₹5 per late day.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>BOOK</th><th>AMOUNT</th><th>CREATED</th><th>STATUS</th><th></th></tr></thead><tbody><c:forEach items="${fines}" var="fine"><tr><td><b><c:out value="${fine.memberName}"/></b></td><td><c:out value="${fine.bookTitle}"/></td><td>₹${fine.amount}</td><td>${fine.createdAt}</td><td><span class="badge ${fine.paid ? 'RETURNED' : 'OVERDUE'}">${fine.paid ? 'PAID' : 'UNPAID'}</span></td><td><c:if test="${!fine.paid && sessionScope.role != 'STUDENT'}"><form method="post" action="${pageContext.request.contextPath}/librarian/fines"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="fineId" value="${fine.id}"/><button class="text-link">Mark paid</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty fines}"><div class="empty">No fines have been recorded.</div></c:if></section><%@ include file="../shared/close.jspf" %>
