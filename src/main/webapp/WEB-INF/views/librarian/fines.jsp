<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Fines"/><%@ include file="../shared/open.jspf" %>
<div class="page-header"><div><div class="eyebrow"><c:choose><c:when test="${sessionScope.role == 'STUDENT'}">YOUR ACCOUNT</c:when><c:otherwise>LATE RETURNS</c:otherwise></c:choose></div><h1>Fine records</h1><p>Fines are calculated when an overdue book is returned at ₹5 per late day.</p></div></div>
<section class="panel table-panel"><div class="panel-heading"><div><h2>Fine activity</h2><p><c:out value="${fines.size()}"/> records</p></div></div><div class="table-scroll"><table><thead><tr><th>STUDENT</th><th>BOOK</th><th>AMOUNT</th><th>CREATED</th><th>STATUS</th><th></th></tr></thead><tbody><c:forEach items="${fines}" var="fine"><tr><td><b><c:out value="${fine.memberName}"/></b></td><td><c:out value="${fine.bookTitle}"/></td><td>₹<c:out value="${fine.amount}"/></td><td><c:out value="${fine.createdAt}"/></td><td><span class="status ${fine.paid ? 'paid' : 'unpaid'}"><c:out value="${fine.paid ? 'PAID' : 'UNPAID'}"/></span></td><td><c:if test="${!fine.paid && sessionScope.role != 'STUDENT'}"><form method="post" action="${pageContext.request.contextPath}/librarian/fines"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="fineId" value="${fine.id}"/><button class="text-link">Mark paid</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty fines}"><div class="empty-inline">No fines have been recorded.</div></c:if></section>
<%@ include file="../shared/close.jspf" %>
