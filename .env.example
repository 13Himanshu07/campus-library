# MySQL 8 connection. Use jdbc:mysql://host:3306/database
DB_URL=jdbc:mysql://localhost:3306/library?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=library_app
DB_PASSWORD=
DDL_AUTO=validate
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
FRONTEND_URL=http://localhost:5173
BORROW_DAYS=14
BORROW_LIMIT=5
FINE_PER_DAY=5
REMINDER_DAYS=2
OVERDUE_CRON=0 0 2 * * *
REMINDER_CRON=0 0 9 * * *
BOOTSTRAP_LIBRARIAN_EMAIL=
BOOTSTRAP_LIBRARIAN_PASSWORD=
