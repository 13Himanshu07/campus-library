# Set in the Tomcat process environment; never commit production credentials.
DB_URL=jdbc:mysql://localhost:3306/library_management?serverTimezone=UTC&sslMode=DISABLED
DB_USERNAME=library_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=library_migrator
DB_MIGRATION_PASSWORD=
APP_ENV=development
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_NAME=CampusLibraryPool
LIBRARY_BORROW_DAYS=14
LIBRARY_BORROW_LIMIT=5
LIBRARY_FINE_PER_DAY=5.00
# Production only: APP_ENV=production, PUBLIC_HTTPS_HOST=library.example.edu,
# TRUST_PROXY_TLS=true only behind a proxy that overwrites X-Forwarded-Proto.
