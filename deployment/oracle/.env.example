# Use unique values for each deployment. Keep this .env file private.
PUBLIC_DOMAIN=library.example.edu
# Generate each secret independently with a separate `openssl rand -hex 32` call.
# All three values must contain only hexadecimal characters for the bootstrap SQL.
MYSQL_ROOT_PASSWORD=replace-with-long-random-hex-root-password
DB_PASSWORD=replace-with-long-random-hex-app-password
DB_MIGRATION_PASSWORD=replace-with-long-random-hex-migration-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_INIT_FAIL_TIMEOUT_MS=10000
DB_POOL_NAME=CampusLibraryPool
LIBRARY_BORROW_DAYS=14
LIBRARY_BORROW_LIMIT=5
LIBRARY_FINE_PER_DAY=5.00
